# ==============================================================================
# CallDesk (Vistara Whitelabel) Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# Application Base URL (Used for generating webhook endpoints and API references)
# For local development with webhooks, use a public tunnel URL (e.g. ngrok / cloudflare tunnel)
APP_URL=http://localhost:4000
NEXT_PUBLIC_BRAND_NAME=CallDesk

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vistara_whitelabel

# JWT Secret for Session Cookie Signing (Generate a random 32+ character string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_chars_min

# Vistara AI Public API Configuration
# Get your API key from https://app.vistaraai.in/connect
VISTARA_API_KEY=your_vistara_api_key_here
VISTARA_API_BASE_URL=https://app.vistaraai.in

# Webhook Secret Token for Inbound Call Outcomes
# The agent's webhook_url in Vistara will be configured with:
# {APP_URL}/api/webhook/vistara?token={WEBHOOK_SHARED_SECRET}
WEBHOOK_SHARED_SECRET=your_random_32_char_webhook_shared_secret

# Platform Concurrency Limiter
# Maximum simultaneous in-flight calls allowed across all users
MAX_CONCURRENT_CALLS=10

# Initial Admin Seeding (Used when running: npm run db:seed)
SEED_ADMIN_EMAIL=admin@platform.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Platform Admin
